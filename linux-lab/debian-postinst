#!/bin/sh
set -eu

case "${1:-}" in
    configure)
        systemctl disable --now reactoros-default-session.service >/dev/null 2>&1 || true
        rm -f /etc/systemd/system/reactoros-default-session.service
        systemctl daemon-reload >/dev/null 2>&1 || true
        python3 /opt/reactoros/reactoros-default-session.py
        extension_source=/usr/share/gnome-shell/extensions/apps-menu@gnome-shell-extensions.gcampax.github.com
        extension_target=/usr/share/gnome-shell/extensions/reactoros-apps-menu@reactoros.local
        if [ -d "$extension_source" ]; then
            install -d -m 0755 "$(dirname "$extension_target")"
            rm -rf -- "$extension_target"
            cp -a "$extension_source" "$extension_target"
            python3 /opt/reactoros/patch-apps-menu.py "$extension_target/extension.js"
        else
            echo 'ReactorOS: GNOME Apps Menu extension missing; reinstall gnome-shell-extension-apps-menu.' >&2
        fi
        dconf update
        ;;
esac

# Deliberately leave the display manager, system default session, and other
# desktop environments untouched. Choose ReactorOS Desktop at sign-in.
exit 0
